# Dockerfile for OpenWebUI service
# This service provides the web UI frontend for the travel agents API
FROM ghcr.io/open-webui/open-webui:main

# Health check to verify service is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# OpenWebUI will use environment variables for configuration
# OPENAI_API_BASE_URL: API endpoint (set via Railway variables)
# OPENAI_API_KEY: dummy key
# WEBUI_AUTH: set to false for public access
