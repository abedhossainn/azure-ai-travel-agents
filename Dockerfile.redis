# Lightweight Redis for Railway
# Uses official Redis 7 Alpine image

FROM redis:7-alpine

# Data persistence via Railway volumes (mount /data in Railway dashboard)
# No VOLUME directive - Railway handles volume mounting

# Optional: basic config tuned for cache usage
# - appendonly yes: durability across restarts
# - maxmemory: cap memory usage (adjust to your plan)
# - maxmemory-policy allkeys-lru: typical cache eviction
# You can override via environment or command in Railway

CMD ["redis-server", "--appendonly", "yes", "--dir", "/data", "--maxmemory", "256mb", "--maxmemory-policy", "allkeys-lru"]

EXPOSE 6379