{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "16808885201167721836"
    }
  },
  "parameters": {
    "acrName": {
      "type": "string",
      "defaultValue": "travelagentacr13864",
      "metadata": {
        "description": "Name of the Azure Container Registry"
      }
    },
    "containerGroupName": {
      "type": "string",
      "defaultValue": "travel-agent-container-group",
      "metadata": {
        "description": "Name for the container group"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "apiImageName": {
      "type": "string",
      "defaultValue": "travel-agent-api",
      "metadata": {
        "description": "API image name in ACR"
      }
    },
    "apiImageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "API image tag"
      }
    },
    "acrUsername": {
      "type": "securestring",
      "metadata": {
        "description": "ACR username for authentication"
      }
    },
    "acrPassword": {
      "type": "securestring",
      "metadata": {
        "description": "ACR password for authentication"
      }
    },
    "containerGroupDnsNameLabel": {
      "type": "string",
      "defaultValue": "[format('travel-agent-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "DNS name label for the container group"
      }
    },
    "googleGenaiApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Google Gemini API Key"
      }
    },
    "amadeusClientId": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Amadeus Client ID"
      }
    },
    "amadeusClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Amadeus Client Secret"
      }
    }
  },
  "variables": {
    "acrLoginServer": "[format('{0}.azurecr.io', parameters('acrName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "[parameters('containerGroupName')]",
      "location": "[parameters('location')]",
      "properties": {
        "containers": [
          {
            "name": "redis",
            "properties": {
              "image": "[format('{0}/redis:7-alpine', variables('acrLoginServer'))]",
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 1
                }
              },
              "ports": [
                {
                  "port": 6379,
                  "protocol": "TCP"
                }
              ],
              "command": [
                "redis-server",
                "--appendonly",
                "yes",
                "--maxmemory",
                "256mb",
                "--maxmemory-policy",
                "allkeys-lru"
              ],
              "livenessProbe": {
                "exec": {
                  "command": [
                    "redis-cli",
                    "ping"
                  ]
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 10
              }
            }
          },
          {
            "name": "api",
            "properties": {
              "image": "[format('{0}/{1}:{2}', variables('acrLoginServer'), parameters('apiImageName'), parameters('apiImageTag'))]",
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 2
                }
              },
              "ports": [
                {
                  "port": 4000,
                  "protocol": "TCP"
                }
              ],
              "environmentVariables": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                },
                {
                  "name": "LLM_PROVIDER",
                  "value": "gemini"
                },
                {
                  "name": "MODEL",
                  "value": "gemini-2.0-flash-lite"
                },
                {
                  "name": "REDIS_URL",
                  "value": "redis://localhost:6379"
                },
                {
                  "name": "GOOGLE_GENAI_API_KEY",
                  "secureValue": "[parameters('googleGenaiApiKey')]"
                },
                {
                  "name": "AMADEUS_CLIENT_ID",
                  "secureValue": "[parameters('amadeusClientId')]"
                },
                {
                  "name": "AMADEUS_CLIENT_SECRET",
                  "secureValue": "[parameters('amadeusClientSecret')]"
                }
              ]
            }
          },
          {
            "name": "ui",
            "properties": {
              "image": "[format('{0}/open-webui:main', variables('acrLoginServer'))]",
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 1
                }
              },
              "ports": [
                {
                  "port": 8080,
                  "protocol": "TCP"
                }
              ],
              "environmentVariables": [
                {
                  "name": "OPENAI_API_BASE_URL",
                  "value": "http://localhost:4000/v1"
                },
                {
                  "name": "OPENAI_API_KEY",
                  "value": "sk-dummy"
                },
                {
                  "name": "WEBUI_NAME",
                  "value": "Travel Agent"
                },
                {
                  "name": "WEBUI_URL",
                  "value": "http://localhost:3000"
                },
                {
                  "name": "WEBUI_AUTH",
                  "value": "false"
                }
              ]
            }
          }
        ],
        "osType": "Linux",
        "restartPolicy": "Always",
        "ipAddress": {
          "type": "Public",
          "dnsNameLabel": "[parameters('containerGroupDnsNameLabel')]",
          "ports": [
            {
              "port": 4000,
              "protocol": "TCP"
            },
            {
              "port": 8080,
              "protocol": "TCP"
            }
          ]
        },
        "imageRegistryCredentials": [
          {
            "server": "[variables('acrLoginServer')]",
            "username": "[parameters('acrUsername')]",
            "password": "[parameters('acrPassword')]"
          }
        ]
      }
    }
  ],
  "outputs": {
    "acrLoginServer": {
      "type": "string",
      "value": "[variables('acrLoginServer')]"
    },
    "containerGroupName": {
      "type": "string",
      "value": "[parameters('containerGroupName')]"
    },
    "containerGroupFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerInstance/containerGroups', parameters('containerGroupName')), '2023-05-01').ipAddress.fqdn]"
    },
    "apiUrl": {
      "type": "string",
      "value": "[format('http://{0}:4000', reference(resourceId('Microsoft.ContainerInstance/containerGroups', parameters('containerGroupName')), '2023-05-01').ipAddress.fqdn)]"
    },
    "uiUrl": {
      "type": "string",
      "value": "[format('http://{0}:8080', reference(resourceId('Microsoft.ContainerInstance/containerGroups', parameters('containerGroupName')), '2023-05-01').ipAddress.fqdn)]"
    }
  }
}