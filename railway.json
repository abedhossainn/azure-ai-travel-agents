{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "api": {
      "build": {
        "builder": "dockerfile",
        "dockerfile": "Dockerfile"
      },
      "deploy": {
        "startCommand": "node dist/index.js",
        "restartPolicyType": "on_failure",
        "restartPolicyMaxRetries": 5,
        "port": 4000
      },
      "variables": {
        "NODE_ENV": "production",
        "LLM_PROVIDER": "gemini",
        "MODEL": "gemini-2.0-flash-lite",
        "PORT": "4000",
        "REDIS_URL": "redis://redis:6379"
      }
    },
    "frontend": {
      "build": {
        "builder": "dockerfile",
        "dockerfile": "Dockerfile.openwebui"
      },
      "deploy": {
        "restartPolicyType": "on_failure",
        "restartPolicyMaxRetries": 5,
        "port": 8080
      },
      "variables": {
        "OPENAI_API_BASE_URL": "${{ api.RAILWAY_PRIVATE_DOMAIN }}/v1",
        "OPENAI_API_KEY": "sk-dummy",
        "WEBUI_NAME": "Travel Agent",
        "WEBUI_AUTH": "false"
      }
    },
    "redis": {
      "image": "redis:7-alpine",
      "deploy": {
        "restartPolicyType": "on_failure",
        "restartPolicyMaxRetries": 5,
        "port": 6379
      },
      "volumes": [
        {
          "name": "redis-data",
          "mountPath": "/data"
        }
      ]
    }
  }
}
