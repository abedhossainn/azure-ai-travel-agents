##############################
# Genkit + Gemini (Default) #
##############################

LLM_PROVIDER=gemini
GEMINI_API_KEY=
model="gemini-2.5-flash-lite"

# API
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Optional: Google Custom Search for live web results in web-search flow
# If unset, the web-search flow falls back to an LLM-only answer with a disclaimer
# Either set GOOGLE_CSE_KEY or GOOGLE_API_KEY (GOOGLE_CSE_KEY takes precedence)
# Docs: https://developers.google.com/custom-search/v1/overview
# GOOGLE_CSE_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_CX=

# Optional: OpenTelemetry (if you enable an OTLP collector)
# OTEL_SERVICE_NAME=api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=x-otlp-header=header-value