{
  "name": "azure-ai-travel-agents-api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx --watch src/index.ts",
    "build": "tsc",
    
    "genkit:dev": "GENKIT_ENV=dev npm run build && genkit start --port 4100 -- node dist/index.js",
    "genkit:mcp": "npm run build && genkit mcp -- node dist/index.js",
    "genkit:mcp:dev": "GENKIT_ENV=dev npm run build && genkit mcp -- node dist/index.js",
    
    "benchmark": "tsx src/scripts/benchmark.ts",
    "benchmark:cache": "tsx src/scripts/cache_benchmark.ts",
    "benchmark:concurrency": "tsx src/scripts/concurrency.ts",
    "benchmark:compare": "tsx src/scripts/compare_benchmarks.ts",
    "benchmark:agents": "tsx src/scripts/compare_agents.ts",
    
    "analyze:cache": "tsx src/scripts/analyze_cache.ts",
    "analyze:cost": "tsx src/scripts/cost_estimate.ts",
    "analyze:logs": "tsx src/scripts/parse_logs.ts",
    "analyze:tokens": "tsx src/scripts/test_tokens.ts",
    
    "test:query": "tsx src/scripts/send_query_server.ts",
    
    "plot": "python3 ../../local-reports/plot_benchmarks.py ../../local-reports/benchmark-comparison.csv",
    "plot:concurrency": "python3 ../../local-reports/plot_concurrency.py"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@genkit-ai/google-genai": "^1.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "amadeus": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "genkit": "^1.22.0",
    "redis": "^5.9.0",
    "zod": "^3.24.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/node-fetch": "^2.6.4",
    "genkit-cli": "^1.22.0",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3"
  },
  "volta": {
    "node": "22.16.0"
  }
}
